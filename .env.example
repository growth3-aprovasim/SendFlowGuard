# =======================================================
# SENDFLOW CONFIGURAÇÕES DA API
# =======================================================
# Chave de API obtida no SendFlow (Bearer Token)
SENDFLOW_API_KEY=sua_chave_de_api_aqui

# URL base da API do SendFlow (padrão)
SENDFLOW_BASE_URL=https://sendapi.sendflow.pro

# ID da Campanha (releaseId) cujos grupos serão monitorados
SENDFLOW_RELEASE_ID=id_da_sua_campanha_aqui

# =======================================================
# CONFIGURAÇÕES DE ATUALIZAÇÃO DE LINK
# =======================================================
# Origem das contas para a ação de atualizar link:
# "release" = todas as contas vinculadas à campanha (recomendado)
# "accounts" = contas específicas fornecidas abaixo
ACCOUNTS_FROM=release

# Caso ACCOUNTS_FROM=accounts, insira os IDs separados por vírgula
# ACCOUNTS_IDS=7LLztsEGLPNAAAAAAAAXfc52,outro_id

# Tempo de espera (em segundos) após disparar o POST de atualização de link
# antes de tentar verificar o novo link gerado (padrão: 60)
RECHECK_DELAY_SECONDS=60

# =======================================================
# AGENDAMENTO E VERIFICAÇÃO
# =======================================================
# Intervalo de verificação em minutos.
# ATENÇÃO: A API do SendFlow possui rate limit de 10 minutos por releaseId no GET de grupos.
# Por isso, o valor recomendado é 10 ou 15 minutos.
CHECK_INTERVAL_MINUTES=10

# Iniciar o agendador automaticamente ao iniciar o sistema (true / false)
AUTO_START_SCHEDULER=true

# =======================================================
# PAINEL WEB (DASHBOARD)
# =======================================================
ENABLE_WEB_DASHBOARD=true
PORT=3000

# =======================================================
# MONITORAMENTO DO LINK MÃE (REDIRECIONADOR PRINCIPAL)
# =======================================================
# Link principal que redireciona os leads para os grupos
# (ex: https://dominio.com/entrar ou https://sendflow.pro/r/...)
# Como este link é o canal de entrada dos leads, é o mais crítico de todos.
MASTER_LINK_URL=

# Intervalo de verificação do Link Mãe em SEGUNDOS (padrão: 60s)
# Como a checagem é direta (não consome rate-limit do SendFlow), pode ser rápida.
MASTER_LINK_INTERVAL_SECONDS=60

# =======================================================
# NOTIFICAÇÕES (OPCIONAL)
# =======================================================
# Para receber alertas quando um link for detectado quebrado, recuperado ou cota de segurança atingida:
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
